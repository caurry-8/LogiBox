* {
    font-family: "Microsoft YaHei";
}

QMainWindow, QWidget {
    background: #15171A;
    color: #E8EAED;
}

#sidebar {
    background: #1C1F23;
    border-right: 1px solid #2D3137;
}

#logoTitle {
    color: #F4F6F8;
    font-size: 28px;
    font-weight: 800;
}

#logoSubtitle, #versionLabel, #topbarHint, #pageDescription, #mutedLabel {
    color: #8E98A5;
}

#sidebarMenu {
    background: transparent;
    border: none;
    outline: none;
    font-size: 14px;
    padding: 2px;
}

#sidebarMenu::item {
    height: 44px;
    padding: 0 14px;
    margin: 2px 0;
    border-radius: 9px;
}

#sidebarMenu::item:hover {
    background: #2A2E34;
}

#sidebarMenu::item:selected {
    background: #136D9C;
    color: #FFFFFF;
}

#topbar {
    background: #1C1F23;
    border-bottom: 1px solid #2D3137;
}

#topbarTitle {
    color: #F4F6F8;
    font-size: 16px;
    font-weight: 700;
}

#heroCard, #panelCard, #metricCard, #functionCard, #chartCard, #MetricCard {
    background: #21252A;
    border: 1px solid #323840;
    border-radius: 16px;
}

#heroTitle {
    color: #F5F7FA;
    font-size: 23px;
    font-weight: 700;
}

#heroText, #cardDescription {
    color: #AAB3BF;
    font-size: 13px;
}

#functionCard:hover {
    background: #272C32;
    border: 1px solid #178BC5;
}

#cardIcon {
    font-size: 38px;
}

#cardTitle {
    color: #F5F7FA;
    font-size: 18px;
    font-weight: 700;
}

#panelTitle, #chartTitle {
    color: #F5F7FA;
    font-size: 17px;
    font-weight: 700;
}

QLineEdit, QComboBox, QDoubleSpinBox {
    background: #17191D;
    border: 1px solid #3C434C;
    border-radius: 9px;
    padding: 8px 10px;
    color: #F5F7FA;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #178BC5;
}

QComboBox QAbstractItemView {
    background: #23272D;
    color: #F5F7FA;
    border: 1px solid #3C434C;
    selection-background-color: #136D9C;
}

QPushButton {
    background: #136D9C;
    border: none;
    border-radius: 9px;
    padding: 10px 15px;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton:hover {
    background: #178BC5;
}

QPushButton:pressed {
    background: #0E5478;
}

QCheckBox {
    color: #D6DCE2;
    spacing: 7px;
}

QTableWidget {
    background: #191C20;
    alternate-background-color: #20242A;
    border: 1px solid #343A42;
    gridline-color: #343A42;
    color: #E6E9ED;
    selection-background-color: #136D9C;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background: #242930;
    color: #F5F7FA;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #3A414A;
}

#metricValue, #bigMetric {
    color: #62C2F4;
    font-size: 19px;
    font-weight: 800;
}

#MetricCardTitle {
    color: #AEB6C2;
    font-size: 13px;
    font-weight: 600;
}

#MetricCardDetail {
    color: #8F99A6;
    font-size: 12px;
}

QStatusBar {
    background: #1C1F23;
    color: #9AA5B1;
    border-top: 1px solid #2D3137;
}

QSplitter::handle {
    background: #343A42;
}

QSplitter::handle:hover {
    background: #178BC5;
}

QScrollBar:vertical {
    background: #17191D;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #4A535F;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
