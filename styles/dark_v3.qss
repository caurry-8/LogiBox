* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "SimHei", "Segoe UI";
    font-size: 12px;
}

QMainWindow,
QWidget#mainRoot,
QStackedWidget,
#pageStack {
    background: #0d1117;
    color: #e6edf3;
}

QStatusBar {
    background: #010409;
    color: #7d8590;
    border-top: 1px solid #21262d;
    min-height: 24px;
}

#sidebar {
    background: #010409;
    border-right: 1px solid #21262d;
}

#brandBlock {
    background: transparent;
    border: none;
}

#logo {
    color: #f0f6fc;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

#subtitle {
    color: #8b949e;
    font-size: 11px;
}

#versionLabel {
    color: #58a6ff;
    font-size: 9px;
    font-weight: 600;
    padding-top: 4px;
}

#navSection {
    color: #6e7681;
    font-size: 10px;
    font-weight: 700;
    padding: 8px 8px 4px 8px;
}

#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #b1bac4;
    text-align: left;
    padding: 8px 10px;
}

#navButton:hover {
    background: #161b22;
    color: #f0f6fc;
}

#navButton:checked {
    background: #21262d;
    color: #f0f6fc;
    border: 1px solid #30363d;
    font-weight: 600;
}

#sidebarFooter {
    background: #0d1117;
    border: 1px solid #21262d;
    border-radius: 6px;
}

#status {
    color: #3fb950;
    font-size: 10px;
    font-weight: 600;
}

#sidebarMeta {
    color: #6e7681;
    font-size: 10px;
}

#pageTitle {
    color: #f0f6fc;
    font-size: 27px;
    font-weight: 600;
}

#pageDescription {
    color: #8b949e;
    font-size: 12px;
}

#pageDivider {
    background: #21262d;
    border: none;
}

#sectionTitle {
    color: #e6edf3;
    font-size: 14px;
    font-weight: 600;
}

#mutedLabel,
#dashboardNoteText {
    color: #8b949e;
    font-size: 11px;
}

#statusBadge {
    background: #161b22;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 11px;
    font-weight: 600;
}

#statusBadge[ready="true"] {
    background: #0f2419;
    color: #3fb950;
    border: 1px solid #238636;
}

#metricCard {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    min-height: 104px;
}

#metricCard:hover {
    border: 1px solid #58a6ff;
}

#metricTitle {
    color: #8b949e;
    font-size: 11px;
}

#metricValue {
    font-size: 24px;
    font-weight: 600;
}

#metricHint {
    color: #6e7681;
    font-size: 10px;
}

#summaryText {
    background: #0d1117;
    color: #c9d1d9;
    border: 1px solid #21262d;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 10px;
    line-height: 1.5;
}

#functionCard {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    min-height: 112px;
}

#functionCard:hover {
    background: #161b22;
    border: 1px solid #58a6ff;
}

#cardTitle {
    color: #e6edf3;
    font-size: 13px;
    font-weight: 600;
}

#cardDescription {
    color: #8b949e;
    font-size: 11px;
}

#cardAction {
    color: #58a6ff;
    font-size: 11px;
    font-weight: 600;
}

#activityRow {
    background: #0d1117;
    border: 1px solid #21262d;
    border-radius: 6px;
}

#activityName {
    color: #c9d1d9;
    font-size: 11px;
}

#activityStatus {
    color: #8b949e;
    font-size: 10px;
    font-weight: 600;
}

#activityStatus[complete="true"] {
    color: #3fb950;
}

#controlBar,
#contentPanel,
#chartPanel,
#tablePanel,
#dashboardNote {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
}

QLineEdit,
QComboBox,
QDoubleSpinBox,
QSpinBox,
QListWidget,
QTextEdit,
QPlainTextEdit {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #e6edf3;
    padding: 6px 8px;
    min-height: 24px;
    selection-background-color: #1f6feb;
}

QLineEdit:hover,
QComboBox:hover,
QDoubleSpinBox:hover,
QSpinBox:hover {
    border-color: #6e7681;
}

QLineEdit:focus,
QComboBox:focus,
QDoubleSpinBox:focus,
QSpinBox:focus,
QListWidget:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #58a6ff;
}

QComboBox QAbstractItemView {
    background: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    selection-background-color: #1f6feb;
}

QPushButton {
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #e6edf3;
    font-weight: 600;
    padding: 7px 13px;
    min-height: 22px;
}

QPushButton:hover {
    background: #30363d;
    border-color: #8b949e;
}

QPushButton:pressed {
    background: #161b22;
}

QPushButton#primaryButton {
    background: #1f6feb;
    border: 1px solid #1f6feb;
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background: #388bfd;
    border-color: #58a6ff;
}

QPushButton#secondaryButton {
    background: #21262d;
    border: 1px solid #30363d;
    color: #c9d1d9;
}

QPushButton#dangerButton {
    background: #21262d;
    border: 1px solid #da3633;
    color: #f85149;
}

QPushButton#dangerButton:hover {
    background: #da3633;
    color: #ffffff;
}

QCheckBox {
    color: #c9d1d9;
    spacing: 7px;
}

QTableWidget {
    background: #0d1117;
    alternate-background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    gridline-color: #21262d;
    color: #c9d1d9;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QHeaderView::section {
    background: #161b22;
    color: #8b949e;
    padding: 8px;
    border: none;
    border-right: 1px solid #21262d;
    border-bottom: 1px solid #30363d;
    font-weight: 600;
}

QTableCornerButton::section {
    background: #161b22;
    border: none;
    border-right: 1px solid #21262d;
    border-bottom: 1px solid #30363d;
}

QHeaderView {
    background: #0d1117;
    border: none;
}

QAbstractScrollArea::corner {
    background: #0d1117;
    border: none;
}

QSplitter::handle {
    background: #21262d;
}

QScrollBar:vertical {
    background: #0d1117;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 26px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

#aboutProduct {
    color: #58a6ff;
    font-size: 24px;
    font-weight: 600;
}

#aboutText {
    color: #c9d1d9;
    font-size: 12px;
}

#matrixHint,
#analysisNote {
    background: #161b22;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 11px;
}

#matrixHint[ready="true"] {
    background: #0f2419;
    color: #3fb950;
    border: 1px solid #238636;
}

#analysisNote[warn="true"] {
    color: #d29922;
    border: 1px solid #9e6a03;
}

QTabWidget::pane {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background: #0d1117;
    color: #8b949e;
    border: 1px solid #30363d;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 16px;
    margin-right: 4px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #e6edf3;
}

QTabBar::tab:selected {
    background: #161b22;
    color: #f0f6fc;
}

#qualityPanel {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
}

#qualityStatus {
    color: #8b949e;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 600;
}

#qualityStatus[severity="ok"] {
    color: #3fb950;
    background: #0f2419;
    border: 1px solid #238636;
}

#qualityStatus[severity="warning"] {
    color: #d29922;
    background: #2b2308;
    border: 1px solid #9e6a03;
}

#qualityStatus[severity="blocker"] {
    color: #f85149;
    background: #2d1214;
    border: 1px solid #da3633;
}

#qualityIssues {
    color: #8b949e;
    font-size: 11px;
}
